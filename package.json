        "@tanstack/react-router": "^1.170.28",
        "better-auth": "^1.6.28",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.3.6",
        "lucide-react": "^1.28.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.84.0",
        "react-i18next": "^17.0.11",
        "react-icons": "^5.7.0",

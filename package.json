{
    "name": "web-spa-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "bun run generate-routes && tsc -b && vite build",
        "generate-routes": "tsr generate",
        "lint": "oxlint && prettier --check .",
        "test": "vitest run --passWithNoTests",
        "typecheck": "bun run generate-routes && tsc -b --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview"
    },
